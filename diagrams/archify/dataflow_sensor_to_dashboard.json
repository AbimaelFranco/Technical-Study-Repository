{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Flujo de datos: del sensor al dashboard",
    "output": "dataflow_sensor_to_dashboard.html",
    "viewBox": [
      1080,
      520
    ],
    "quality_profile": "showcase"
  },
  "stages": [
    {
      "label": "Sensores"
    },
    {
      "label": "MCU"
    },
    {
      "label": "Gateway"
    },
    {
      "label": "Servidor"
    },
    {
      "label": "Consumo"
    }
  ],
  "nodes": [
    {
      "id": "sensors",
      "type": "external",
      "label": "Sensores",
      "sublabel": "1-Wire / I2C",
      "stage": 0,
      "row": 0,
      "tag": "fisico"
    },
    {
      "id": "ecu",
      "type": "external",
      "label": "ECU tractor",
      "sublabel": "CAN J1939",
      "stage": 0,
      "row": 2,
      "tag": "tramas"
    },
    {
      "id": "mcu",
      "type": "backend",
      "label": "Nodo MCU",
      "sublabel": "valida + empaqueta",
      "stage": 1,
      "row": 0,
      "tag": "C/C++"
    },
    {
      "id": "gw",
      "type": "backend",
      "label": "Gateway",
      "sublabel": "Linux + Python",
      "stage": 2,
      "row": 1,
      "tag": "timestamp"
    },
    {
      "id": "buf",
      "type": "database",
      "label": "Buffer SQLite",
      "sublabel": "store & forward",
      "stage": 2,
      "row": 2,
      "tag": "sin red"
    },
    {
      "id": "broker",
      "type": "messagebus",
      "label": "Broker MQTT",
      "sublabel": "topics por maquina",
      "stage": 3,
      "row": 1,
      "tag": "TLS"
    },
    {
      "id": "db",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "series de tiempo",
      "stage": 3,
      "row": 0,
      "tag": "historico"
    },
    {
      "id": "rules",
      "type": "backend",
      "label": "Reglas",
      "sublabel": "umbrales + timeout",
      "stage": 3,
      "row": 2,
      "tag": "alertas"
    },
    {
      "id": "dash",
      "type": "frontend",
      "label": "Dashboard",
      "sublabel": "Grafana / Django",
      "stage": 4,
      "row": 0,
      "tag": "SQL"
    },
    {
      "id": "notify",
      "type": "external",
      "label": "Notificacion",
      "sublabel": "correo / mensajeria",
      "stage": 4,
      "row": 2,
      "tag": "alerta"
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "sensors",
      "to": "mcu",
      "label": "lecturas crudas",
      "classification": "ADC / bus",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "f2",
      "from": "mcu",
      "to": "gw",
      "label": "mensajes UART",
      "classification": "validados",
      "variant": "emphasis"
    },
    {
      "id": "f3",
      "from": "ecu",
      "to": "gw",
      "label": "tramas CAN",
      "classification": "decodificadas",
      "variant": "emphasis"
    },
    {
      "id": "f4",
      "from": "gw",
      "to": "buf",
      "label": "pendientes",
      "classification": "sin red",
      "variant": "dashed",
      "route": "straight",
      "labelDy": 24
    },
    {
      "id": "f5",
      "from": "gw",
      "to": "broker",
      "label": "JSON + TLS",
      "classification": "salida",
      "variant": "security"
    },
    {
      "id": "f6",
      "from": "broker",
      "to": "db",
      "label": "historico",
      "classification": "persistido",
      "variant": "default",
      "labelDy": -8
    },
    {
      "id": "f7",
      "from": "broker",
      "to": "rules",
      "label": "eventos",
      "classification": "tiempo real",
      "variant": "default",
      "labelDy": 24
    },
    {
      "id": "f8",
      "from": "db",
      "to": "dash",
      "label": "consulta",
      "classification": "lectura",
      "variant": "default",
      "route": "straight"
    },
    {
      "id": "f9",
      "from": "rules",
      "to": "notify",
      "label": "alerta",
      "classification": "umbral",
      "variant": "security",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Camino principal",
      "items": [
        "Fisico a digital en el MCU",
        "El gateway agrega timestamp y ID de dispositivo",
        "El broker desacopla campo y servidor"
      ]
    },
    {
      "dot": "amber",
      "title": "Sin conexion",
      "items": [
        "El buffer local retiene los mensajes",
        "Se reenvia con reintentos al recuperar red",
        "Idempotencia evita duplicados"
      ]
    }
  ]
}